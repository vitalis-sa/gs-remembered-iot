# Exemplo de configuracao. Copie para .env e preencha com os seus valores.
# No n8n, estes valores ficam nas CREDENCIAIS (Settings > Credentials), nao no workflow.
# Nunca suba o arquivo .env para o repositorio.

# Groq (LLM): credencial "Groq API" no n8n
GROQ_API_KEY=coloque_sua_chave_aqui

# Embeddings: o workflow usa OpenAI text-embedding-3-small.
# Credencial "OpenAI API" no n8n (ou os creditos do gateway do n8n Cloud).
OPENAI_API_KEY=coloque_sua_chave_aqui

# MongoDB Atlas (base vetorial das bulas): credencial "MongoDB" no n8n
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net
MONGODB_DB=nome_do_banco
MONGODB_COLLECTION=bulas_chunks
MONGODB_VECTOR_INDEX=bulas_vector_index

# API Java (valida o token do idoso e lista os medicamentos ativos).
# Troque a URL nos nos "Validar Token (GET me)" e "Buscar Medicamentos Ativos".
JAVA_API_BASE_URL=https://sua-api-java.exemplo.com

# URL do webhook publicado no n8n (usada pelo app e pelos testes)
N8N_WEBHOOK_URL=https://sua-instancia.app.n8n.cloud/webhook/chat-assistente
